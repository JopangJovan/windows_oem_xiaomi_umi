[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Mfg%
DriverVer=11/21/2026,0.1.0.2
CatalogFile=umi-audio.cat
PnpLockdown=1

[SourceDisksNames]
1=%Disk%,,,""

[SourceDisksFiles]
umi-audio.sys=1

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%Mfg%=UmiAudio,NTARM64

[UmiAudio.NTARM64]
%DeviceDesc%=UmiAudio_Install,ACPI\UMI0005

[UmiAudio_Install]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=UmiAudio_CopyFiles
AddReg=UmiAudio_AddReg

[UmiAudio_Install.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,UmiAudio.Interface.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,UmiAudio.Interface.Wave
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_Wave%,UmiAudio.Interface.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,UmiAudio.Interface.Topology
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_Topology%,UmiAudio.Interface.Topology

[UmiAudio.Interface.Wave]
AddReg=UmiAudio.Interface.Wave.AddReg

[UmiAudio.Interface.Wave.AddReg]
HKR,,FriendlyName,,%WaveName%
HKR,,CLSID,,%Proxy.CLSID%

[UmiAudio.Interface.Topology]
AddReg=UmiAudio.Interface.Topology.AddReg

[UmiAudio.Interface.Topology.AddReg]
HKR,,FriendlyName,,%TopoName%

[UmiAudio_CopyFiles]
umi-audio.sys

[UmiAudio_AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,umi-audio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDesc%

[UmiAudio_Install.Services]
AddService=UmiAudio,0x00000002,UmiAudio_Service

[UmiAudio_Service]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\umi-audio.sys

[Strings]
Mfg="UMI development"
Disk="UMI Audio Driver Disk"
DeviceDesc="Xiaomi Mi 10 Stereo Speakers"
ServiceDesc="Xiaomi Mi 10 Stereo Speakers Driver"
WaveName="Xiaomi Mi 10 Speakers Wave"
TopoName="Xiaomi Mi 10 Speakers Topology"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNAME_Wave="Wave"
KSNAME_Topology="Topology"
